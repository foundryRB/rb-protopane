# k8s-target: namespace=protopane, name=protopane-auth, type=Opaque
# The app's HTTP Basic credential for its /mcp machine door (fails closed until this
# Secret exists). Copy to k8s/secrets/protopane-auth.env (git-ignored), fill the values, and
# apply with the platform's seed/apply-secrets.sh. Never commit the real file.
PROTOPANE_AUTH_USER=
PROTOPANE_AUTH_PASSWORD=
