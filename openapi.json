  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness/readiness probe; exempt from auth, and skipped at the OIDC\ngate so an external observer can read which release serves without a\ncredential.\n\n$APP_VERSION is the chart's image tag - the value promotion writes back -\nso the answer describes the pod rather than the source tree. The package\nconstant is the local-dev fallback only: a hardcoded string is not\nfreshness.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
