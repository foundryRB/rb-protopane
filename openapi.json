                }
              }
            }
          }
        }
      }
    },
    "/api/agent-credential": {
      "get": {
        "summary": "Agent Credential",
        "description": "The MCP HTTP Basic credential (base64 of user:password) for the in-app\n\"Connect an agent\" one-liner.\n\nReads the same PROTOPANE_AUTH_USER / PROTOPANE_AUTH_PASSWORD pair the auth\ngate enforces. Reachable only by an already-authenticated caller: under\nscope=mcp the oauth2-proxy in front admits only a logged-in human; under\nscope=all the Basic gate covers it. Answers 503 when the credential is\nunset, mirroring the fail-closed auth posture (there is nothing to hand out).",
        "operationId": "agent_credential_api_agent_credential_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCredentialResponse"
                }
              }
            }
          }
        }
      }
    },
